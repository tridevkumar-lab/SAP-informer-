APP_NAME=SAP Yard Assistant
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/assistant.db

# Local model server. Install/run Ollama separately, then pull a model locally.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional SAP read-only OData adapter. Leave blank until SAP Basis/ABAP team
# provides an approved service and dedicated read-only technical user.
SAP_STOCK_ODATA_URL=
SAP_USERNAME=
SAP_PASSWORD=
SAP_VERIFY_TLS=true
SAP_TIMEOUT_SECONDS=15
